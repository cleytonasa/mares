# 1. Permissões de Acesso e Índices
Options -Indexes +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

# 2. Definição Explícita de MIME Types (HostGator / Apache)
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg .svgz
  AddType image/x-icon .ico
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

# 3. Regras de Roteamento SPA
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Não reescrever requisições para arquivos ou pastas físicas existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Se for um arquivo de asset (js, css, png, svg, webmanifest, json) que não existe, retorne 404 real em vez do index.html
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|png|jpg|jpeg|gif|svg|ico|webmanifest|json|woff|woff2)$ [NC]
  RewriteRule ^ - [R=404,L]

  # Fallback de SPA apenas para páginas de navegação
  RewriteRule ^ index.html [L]
</IfModule>

# 4. Compressão GZIP / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. Configuração de Cache
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|json|webmanifest)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  
  # Adicionar header correto de CORS e MIME para JS
  <FilesMatch "\.(js|mjs)$">
    Header set Content-Type "application/javascript; charset=utf-8"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
