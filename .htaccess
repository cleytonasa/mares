# Permissões de Acesso e Índices
Options -Indexes +FollowSymLinks
DirectoryIndex production/index.html dist/index.html index.html index.php

<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing physical files directly (JS, CSS, SVGs, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If accessing root directory or dev index.html directly on Apache, serve production build
  RewriteRule ^$ production/index.html [L]
  RewriteRule ^index\.html$ production/index.html [L]

  # Single Page Application rewrite fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ production/index.html [L]
</IfModule>


# GZIP Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caching for assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

