# Apache Configuration for SPA in subfolder /mares/
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg .svgz
  AddType image/x-icon .ico
  AddType image/png .png
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /mares/

  # 1. Se o arquivo ou diretório existir exatamente no disco, sirva direto
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Compatibilidade retroativa: se o navegador requisitar qualquer JS que não existe mais, entregue o bundle JS atual
  RewriteCond %{REQUEST_URI} assets/.*\.js$ [NC]
  RewriteRule ^assets/.*\.js$ assets/index-BWqp4bwG.js [L]

  # 3. Compatibilidade retroativa: se o navegador requisitar qualquer CSS que não existe mais, entregue o CSS atual
  RewriteCond %{REQUEST_URI} assets/.*\.css$ [NC]
  RewriteRule ^assets/.*\.css$ assets/index-mxmAu9cx.css [L]

  # 4. Outros tipos de assets estáticos que não existem devem retornar 404
  RewriteCond %{REQUEST_URI} \.(png|jpg|jpeg|gif|svg|ico|webmanifest|json|woff|woff2)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 5. Fallback para index.html (SPA)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|json|webmanifest)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
